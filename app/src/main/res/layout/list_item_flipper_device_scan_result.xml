<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/list_item_flipper_device_scan_result_layout"
    style="@style/Widget.BleAdvertiser.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    tools:context=".ui.spamDetector.SpamDetectorFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <ImageView
            android:id="@+id/list_item_flipper_device_scan_result_icon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            android:src="@drawable/dolphin"
            app:tint="?attr/colorPrimary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/list_item_flipper_device_scan_result_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.BleAdvertiser.Title"
                    android:textColor="?attr/colorOnSurface"
                    tools:text="Flipper Zero" />

                <TextView
                    android:id="@+id/list_item_flipper_device_scan_result_rssi"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.BleAdvertiser.Label"
                    android:textColor="?attr/colorPrimary"
                    android:textDirection="ltr"
                    tools:text="-55 dBm" />
            </LinearLayout>

            <TextView
                android:id="@+id/list_item_flipper_device_scan_result_address"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.BleAdvertiser.Caption"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textDirection="ltr"
                tools:text="12:34:56:78:9A:BC" />

            <TextView
                android:id="@+id/list_item_flipper_device_scan_result_deviceType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.BleAdvertiser.Caption"
                android:textColor="?attr/colorOnSurfaceVariant"
                tools:text="Flipper Zero Black" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
