<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/advertisementFragmentLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".ui.advertisement.AdvertisementFragment">
    <ExpandableListView
        android:id="@+id/advertisementFragmentCollectionExpandableListview"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingHorizontal="@dimen/screen_padding"
        android:paddingBottom="12dp"
        android:divider="@android:color/transparent"
        android:dividerHeight="4dp"
        android:childDivider="@android:color/transparent" />
    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.BleAdvertiser.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/screen_padding"
        android:layout_marginVertical="12dp"
        app:cardBackgroundColor="?attr/colorSurfaceContainer">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:orientation="vertical">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <ImageView
                    android:id="@+id/advertisementFragmentTargetImage"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginEnd="16dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/bluetooth"
                    app:tint="?attr/colorPrimary" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/advertisementFragmentCurrentSetTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:text="@string/session_ready"
                        android:textAppearance="@style/TextAppearance.BleAdvertiser.Title" />
                    <TextView
                        android:id="@+id/advertisementFragmentCurrentSetSubTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:text="@string/session_selection_hint"
                        android:textAppearance="@style/TextAppearance.BleAdvertiser.Caption" />
                </LinearLayout>
            </LinearLayout>
            <TextView
                android:id="@+id/session_readiness_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/session_requirements_missing"
                android:textAppearance="@style/TextAppearance.BleAdvertiser.Caption"
                android:textColor="?attr/colorError"
                android:visibility="gone" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/advertisementFragmentPlayButton"
                style="@style/Widget.BleAdvertiser.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/session_start"
                app:icon="@drawable/play_arrow"
                app:iconGravity="textStart" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
