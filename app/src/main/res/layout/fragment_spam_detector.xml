<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/spamDetectorLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    tools:context=".ui.spamDetector.SpamDetectorFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/screen_padding">

        <TextView
            android:id="@+id/spamDetectorFragmentTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/detector_screen_title"
            android:textAppearance="@style/TextAppearance.BleAdvertiser.Headline"
            android:textColor="?attr/colorOnSurface" />

        <TextView
            android:id="@+id/spamDetectorFragmentSubTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/detector_screen_description"
            android:textAppearance="@style/TextAppearance.BleAdvertiser.Body"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/spamDetectorTopLayout"
            style="@style/Widget.BleAdvertiser.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/section_spacing">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <com.airbnb.lottie.LottieAnimationView
                    android:id="@+id/spamDetectionAnimation"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:layout_marginEnd="16dp"
                    android:importantForAccessibility="no"
                    android:padding="4dp"
                    app:lottie_autoPlay="false"
                    app:lottie_loop="true"
                    app:lottie_rawRes="@raw/detect" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/spamDetectorStatusText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:accessibilityLiveRegion="polite"
                        android:text="@string/detector_status_stopped"
                        android:textAppearance="@style/TextAppearance.BleAdvertiser.Title"
                        android:textColor="?attr/colorOnSurface" />

                    <TextView
                        android:id="@+id/spamDetectorStatusDescription"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/detector_status_stopped_description"
                        android:textAppearance="@style/TextAppearance.BleAdvertiser.Body"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/spamDetectorToggleButton"
                        style="@style/Widget.BleAdvertiser.Button.Primary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:minWidth="120dp"
                        android:text="@string/detector_start"
                        app:icon="@drawable/play_arrow"
                        app:iconGravity="textStart"
                        app:iconTint="?attr/colorOnPrimary" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/spamDetectorCenterLayout"
            style="@style/Widget.BleAdvertiser.Card.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/section_spacing">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/spamDetectorFlipperListTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/detector_flipper_section_title"
                    android:textAppearance="@style/TextAppearance.BleAdvertiser.Title"
                    android:textColor="?attr/colorOnSurface" />

                <TextView
                    android:id="@+id/spamDetectorFlipperEmptyText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:accessibilityLiveRegion="polite"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    android:text="@string/detector_flipper_empty_idle"
                    android:textAppearance="@style/TextAppearance.BleAdvertiser.Body"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/spamDetectionFlipperDevicesList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    android:visibility="gone"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tools:itemCount="1"
                    tools:listitem="@layout/list_item_flipper_device_scan_result" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/spamDetectorBottomLayout"
            style="@style/Widget.BleAdvertiser.Card.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/section_spacing">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/spamDetectorSpamListTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/detector_packages_section_title"
                    android:textAppearance="@style/TextAppearance.BleAdvertiser.Title"
                    android:textColor="?attr/colorOnSurface" />

                <TextView
                    android:id="@+id/spamDetectorPackagesEmptyText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:accessibilityLiveRegion="polite"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    android:text="@string/detector_packages_empty_idle"
                    android:textAppearance="@style/TextAppearance.BleAdvertiser.Body"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/spamDetectionSpamPackageList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    android:visibility="gone"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tools:itemCount="1"
                    tools:listitem="@layout/list_item_spam_package_scan_result" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
