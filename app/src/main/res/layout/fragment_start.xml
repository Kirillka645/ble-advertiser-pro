<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    tools:context=".ui.start.StartFragment">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/screen_padding">
        <include android:id="@+id/info_card" layout="@layout/card_system_info" />
        <TextView
            android:id="@+id/startFragmentRequirementsHeadline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/section_spacing"
            android:accessibilityHeading="true"
            android:text="@string/home_setup_title"
            android:textAppearance="@style/TextAppearance.BleAdvertiser.Headline" />
        <TextView
            android:id="@+id/startFragmentRequirementsTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:text="@string/home_setup_pending"
            android:textAppearance="@style/TextAppearance.BleAdvertiser.Body" />
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/startFragmentPermissionsCardview"
            style="@style/Widget.BleAdvertiser.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:clickable="true"
            android:focusable="true"
            android:screenReaderFocusable="true">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="88dp"
                android:gravity="center_vertical"
                android:padding="20dp"
                android:orientation="horizontal">
                <FrameLayout android:layout_width="28dp" android:layout_height="28dp">
                    <ImageView
                        android:id="@+id/startFragmentPermissionStatusIcon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/key_24"
                        app:tint="?attr/colorPrimary" />
                </FrameLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="16dp"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/home_permissions_title"
                        android:textAppearance="@style/TextAppearance.BleAdvertiser.Title" />
                    <TextView
                        android:id="@+id/startFragmentPermissionStatusText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textAppearance="@style/TextAppearance.BleAdvertiser.Body" />
                </LinearLayout>
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="?attr/colorOnSurfaceVariant" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/start_fragment_bluetooth_cardview"
            style="@style/Widget.BleAdvertiser.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:clickable="true"
            android:focusable="true"
            android:screenReaderFocusable="true">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="88dp"
                android:gravity="center_vertical"
                android:padding="20dp"
                android:orientation="horizontal">
                <FrameLayout android:layout_width="28dp" android:layout_height="28dp">
                    <ImageView
                        android:id="@+id/startFragmentBluetoothStatusIcon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/bluetooth"
                        app:tint="?attr/colorPrimary" />
                </FrameLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="16dp"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/home_bluetooth_title"
                        android:textAppearance="@style/TextAppearance.BleAdvertiser.Title" />
                    <TextView
                        android:id="@+id/startFragmentBluetoothStatusText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textAppearance="@style/TextAppearance.BleAdvertiser.Body" />
                </LinearLayout>
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="?attr/colorOnSurfaceVariant" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/start_fragment_database_cardview"
            style="@style/Widget.BleAdvertiser.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:clickable="true"
            android:focusable="true"
            android:screenReaderFocusable="true">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="88dp"
                android:gravity="center_vertical"
                android:padding="20dp"
                android:orientation="horizontal">
                <FrameLayout android:layout_width="28dp" android:layout_height="28dp">
                    <ImageView
                        android:id="@+id/startFragmentDatabaseCardIcon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/data_array"
                        app:tint="?attr/colorPrimary" />
                    <com.google.android.material.progressindicator.CircularProgressIndicator
                        android:id="@+id/startFragmentDatabaseCardSeedingAnimation"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:indeterminate="true"
                        android:importantForAccessibility="no"
                        android:visibility="gone"
                        app:indicatorSize="24dp"
                        app:trackThickness="2dp"
                        app:indicatorInset="0dp" />
                </FrameLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="16dp"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/home_database_title"
                        android:textAppearance="@style/TextAppearance.BleAdvertiser.Title" />
                    <TextView
                        android:id="@+id/startFragmentDatabaseStatusText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textAppearance="@style/TextAppearance.BleAdvertiser.Body" />
                </LinearLayout>
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="?attr/colorOnSurfaceVariant" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/home_browse_collections"
            style="@style/Widget.BleAdvertiser.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/section_spacing"
            android:text="@string/home_browse"
            app:icon="@drawable/list"
            app:iconGravity="textStart" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="@string/home_responsible_use"
            android:textAppearance="@style/TextAppearance.BleAdvertiser.Caption" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
