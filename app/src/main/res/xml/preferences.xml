<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory
        android:title="@string/settings_ui_category_advertising"
        app:iconSpaceReserved="false">
        <SwitchPreferenceCompat
            app:key="@string/preference_key_use_legacy_advertising"
            app:title="@string/settings_ui_legacy_advertising_title"
            app:summary="@string/settings_ui_legacy_advertising_summary"
            app:defaultValue="true" />

        <EditTextPreference
            android:defaultValue="1000"
            android:digits="0123456789"
            android:inputType="number|numberDecimal"
            android:key="@string/preference_key_interval_advertising_queue_handler"
            android:selectAllOnFocus="true"
            android:singleLine="true"
            android:summary="@string/settings_ui_advertising_duration_summary"
            android:title="@string/settings_ui_advertising_duration_title" />

        <SwitchPreferenceCompat
            app:key="@string/preference_key_burst_mode"
            app:title="@string/settings_ui_burst_mode_title"
            app:summary="@string/settings_ui_burst_mode_summary"
            app:defaultValue="false" />

        <EditTextPreference
            android:defaultValue="0"
            android:digits="0123456789"
            android:inputType="number"
            android:key="@string/preference_key_auto_stop_minutes"
            android:selectAllOnFocus="true"
            android:singleLine="true"
            android:summary="@string/settings_ui_auto_stop_summary"
            android:title="@string/settings_ui_auto_stop_title" />
    </PreferenceCategory>

    <PreferenceCategory
        android:title="@string/settings_ui_category_appearance"
        app:iconSpaceReserved="false">
        <SwitchPreferenceCompat
            app:key="@string/preference_key_use_dynamic_colors"
            app:title="@string/settings_ui_dynamic_colors_title"
            app:summary="@string/settings_ui_dynamic_colors_summary"
            app:defaultValue="true" />

        <ListPreference
            app:key="theme_mode"
            app:title="@string/settings_ui_theme_title"
            app:entries="@array/theme_mode_entries"
            app:entryValues="@array/theme_mode_values"
            app:defaultValue="default" />
    </PreferenceCategory>

    <PreferenceCategory
        android:title="@string/settings_ui_category_logging"
        app:iconSpaceReserved="false">
        <SwitchPreferenceCompat
            app:key="@string/preference_key_enable_logging"
            app:title="@string/settings_ui_logging_title"
            app:summary="@string/settings_ui_logging_summary"
            app:defaultValue="false" />
    </PreferenceCategory>
</PreferenceScreen>
